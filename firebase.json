{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "AGENTS.md",
      "handoff.md"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "https://changyiwu.github.io/app-drink-fb/",
        "type": 302
      },
      {
        "source": "/:path*",
        "destination": "https://changyiwu.github.io/app-drink-fb/:path",
        "type": 302
      }
    ],
    "site": "drink-ordering-chang"
  }
}
